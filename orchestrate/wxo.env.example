# Configuration for setup_demo.sh and the orchestrate/ scripts.
# Copy to orchestrate/wxo.env and fill in. This file holds secrets:
# never share or commit it (it is in .gitignore).
# setup_demo.sh writes the values it creates (Cognito, agent ARNs) back here.

# --- watsonx Orchestrate instance (Settings > API details) ---
WXO_URL=https://api.<region>.watson-orchestrate.cloud.ibm.com/instances/<id>
WXO_API_KEY=
# Local ADK environment name. Use a NEW name when you switch to another
# instance: "orchestrate env add" ignores a name that already exists.
WXO_ENV_NAME=wxo-dswt2026
# Instance CRN (IBM Cloud > Resource list > watsonx Orchestrate > CRN).
# Only needed when the API key cannot read the IBM Cloud Resource Controller
# ("Could not get CRN" / 403 at setup_demo.sh step 8).
WXO_CRN=

# --- Several demos side by side on the same instance (optional) ---
# SUFFIX is appended to technical names (e.g. _jd), LABEL to display names.
SUFFIX=
LABEL=

# --- AWS account hosting the two AgentCore agents ---
AWS_PROFILE=
# Filled in by setup_demo.sh steps 3-5 (leave empty on first run):
COGNITO_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_TOKEN_URL=
AGENTCORE_ARN=
POLICY_ADVISOR_ARN=

# --- Support Ops Copilot (Confluent Real-Time Context Engine) ---
# Leave RTCE_KEY empty to skip the copilot (steps 7-9 are then skipped).
# Key and secret: terraform -chdir=terraform/confluent-intelligence output -raw rtce_api_key / rtce_api_secret
# URL:            terraform -chdir=terraform/confluent-intelligence output -raw rtce_mcp_endpoint
RTCE_URL=https://mcp.us-east-1.aws.confluent.cloud/mcp/v1/context-engine/organizations/<org>/environments/<env>/kafka-clusters/<lkc>
RTCE_KEY=
RTCE_SECRET=

# --- Copilot bubble in the app ---
# Language of the embedded chat (en by default).
EMBED_LOCALE=en
# true = turn off embedded-chat security on the WHOLE instance (anonymous
# access). Convenient for a demo; do not use on a shared or production instance.
EMBED_DISABLE_SECURITY=false

# --- Goodwill Policy Advisor traces in Orchestrate Observability ---
ADVISOR_TRACING=true
