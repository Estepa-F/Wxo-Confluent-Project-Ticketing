# support_portal configuration
# Copy to .env and fill in real values. Never commit the real .env file.

# --- App behavior ---
ACCOUNT_POOL_SIZE=250
MATCH_THRESHOLD=50
ADMIN_TOKEN=change-me
PORT=8000
ENABLE_GENERATOR=true
GENERATOR_RATE=0.5
# Add the public deployment hostname here before the event, e.g.
# MCP_ALLOWED_HOSTS=localhost:*,127.0.0.1:*,my-portal.fly.dev
MCP_ALLOWED_HOSTS=localhost:*,127.0.0.1:*

# --- Confluent Cloud Kafka ---
CC_BOOTSTRAP_SERVERS=pkc-xxxxx.region.provider.confluent.cloud:9092
CC_API_KEY=
CC_API_SECRET=
CC_SECURITY_PROTOCOL=SASL_SSL
CC_SASL_MECHANISMS=PLAIN

# --- Confluent Cloud Schema Registry ---
CC_SCHEMA_REGISTRY_URL=https://psrc-xxxxx.region.provider.confluent.cloud
CC_SCHEMA_REGISTRY_API_KEY=
CC_SCHEMA_REGISTRY_API_SECRET=
