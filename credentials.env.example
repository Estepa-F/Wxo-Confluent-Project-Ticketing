# Copy to credentials.env (gitignored) and fill in real values.
# deploy.py loads this file and exports every key here as an environment
# variable before running Terraform, so TF_VAR_x here becomes var.x in
# terraform/base, terraform/app-hosting, and terraform/confluent-intelligence.

TF_VAR_confluent_cloud_api_key=
TF_VAR_confluent_cloud_api_secret=

# Optional -- only needed if you want to override the Terraform defaults
# ("dswt2026" / "eu-west-1"). Once applied under a given name_prefix,
# changing it here will make Terraform try to rename/recreate resources.
# TF_VAR_name_prefix=
# TF_VAR_region=

# Required for `python3 deploy.py --stage app` (terraform/app-hosting),
# and also for `--stage intelligence` when TF_VAR_intelligence_enable_bedrock_model=true
# below (terraform/confluent-intelligence creates its own dedicated
# Bedrock IAM user with these). Not TF_VAR_* -- these are standard AWS
# SDK/CLI env var names, read directly by the AWS Terraform provider(s)
# and the `aws`/`docker` CLIs deploy.py shells out to.
#
# Recommended: a named profile from `aws configure sso` / `~/.aws/config`
# (auto-refreshing, no copy-pasted keys to go stale or get truncated).
AWS_PROFILE=
AWS_REGION=eu-west-1

# Alternative to AWS_PROFILE: raw credentials (e.g. from `aws configure`
# or an exported STS session). AWS_SESSION_TOKEN is only needed for
# temporary credentials.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# TF_VAR_app_admin_token is added here automatically by deploy.py the
# first time you run --stage app (a generated secret for the deployed
# app's presenter console) -- you shouldn't need to set this by hand.

# --- Optional: terraform/confluent-intelligence's TRIAGEAGENT pipeline ---
# Only relevant for `python3 deploy.py --stage intelligence` (or
# `--stage all`). Leave both flags at "false" (the default) to apply just
# the ticket enrichment/metrics statements + RTCE key -- that's the
# common case and needs nothing below.
# TF_VAR_intelligence_enable_bedrock_model=false
# TF_VAR_intelligence_enable_agent=false

# When TF_VAR_intelligence_enable_bedrock_model=true above,
# terraform/confluent-intelligence creates its own dedicated IAM user
# (least-privilege: bedrock:InvokeModel on Anthropic models only) and a
# long-lived access key for the Flink Bedrock connection -- you no longer
# supply any Bedrock-specific AWS credentials by hand, and there's no SSO
# session token to keep refreshing. It just needs the AWS_PROFILE/
# AWS_REGION (or AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY) above -- the
# same admin profile used one time to create that IAM user. That profile
# is never itself used to call Bedrock.

# Optional -- AI_SENTIMENT is Early Access (Confluent blog, May 2026) and
# was only confirmed working in us-east-1. Set to false if your Confluent
# organization is not enrolled or if you deploy elsewhere: the
# sentiment_analysis column is then omitted, the rest of the demo works.
# TF_VAR_intelligence_enable_ai_sentiment=true

# Optional -- max CFU for the Flink compute pool (default: 20).
# TF_VAR_intelligence_flink_max_cfu=5

# Optional -- manual override for the deployed app's public URL. Normally
# left unset: terraform/confluent-intelligence auto-derives this from
# terraform/app-hosting's `ingress_url` output once you've run
# `python3 deploy.py --stage app`. Only set this if testing against an
# app hosted somewhere other than terraform/app-hosting.
# TF_VAR_app_public_url=
